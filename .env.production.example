# Production environment template.
# Copy these keys into your hosting provider's Environment settings (Render → Environment).
# NEVER commit a real .env file or real passwords to the repository.

APP_NAME="Haythem Aljane Portfolio"
APP_ENV=production
APP_KEY=                      # run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database: Render provides DATABASE_URL automatically when you attach a Postgres database.
# Leave DB_CONNECTION=pgsql and the app reads DATABASE_URL. For a local MySQL use mysql + DB_* vars.
DB_CONNECTION=pgsql
DATABASE_URL=

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Contact form mail (Gmail: create an App Password at myaccount.google.com/apppasswords)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=your-email@gmail.com

# Admin panel login (/login)
ADMIN_NAME="Haythem Aljane"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=choose-a-strong-password

# Freelance profiles shown in the "Hire me" block (leave empty to hide)
UPWORK_PROFILE_URL=https://www.upwork.com/freelancers/~012467a182dbff0da6
FIVERR_PROFILE_URL=
SHOPIFY_PARTNER_URL=
FREELANCER_PROFILE_URL=
MALT_PROFILE_URL=
BEHANCE_PROFILE_URL=
