APP_NAME=Portfolio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://haythem-portfolio.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=aljanehaythem23@gmail.com
ADMIN_NAME=useradmin

# IMPORTANT:
# Replace the Gmail values above with your actual production credentials in the hosting environment.
# Never commit a real Gmail password to the repository.
